# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
.env
.env.local
.env.*.local
!.env.example

# Tauri (Phase 2C)
src-tauri/target
# gen/android is committed (source). Build outputs inside it are ignored by its own
# nested .gitignore files. Only the generated JSON schemas are ignored here.
src-tauri/gen/schemas
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-tauri/icons/android/
src-tauri/icons/ios/

# Android signing keystore — never commit the keystore binary.
*.jks
*.keystore

# Test artifacts
coverage
.nyc_output

# TypeScript build info
*.tsbuildinfo

.claude/
