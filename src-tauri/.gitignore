/target/
/gen/schemas/

# Icon binaries are generated from icon.svg via `npm run tauri:icon`.
# Comment these out and commit the binaries if your CI doesn't run the generation step.
icons/32x32.png
icons/64x64.png
icons/128x128.png
icons/128x128@2x.png
icons/icon.png
icons/icon.icns
icons/icon.ico
icons/Square*.png
icons/StoreLogo.png
icons/ios/

# Android launcher icons are also generated by `npm run tauri:icon` (run before each Android build).
gen/android/app/src/main/res/mipmap-*/ic_launcher*.png

# Android signing — never commit the keystore binary.
# (keystore.properties / key.properties are already ignored by gen/android/.gitignore)
*.jks
*.keystore
