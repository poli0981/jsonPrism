{
  "name": "jsonprism",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "description": "Disperse JSON into many formats — JSONL, CSV, YAML, XML, TOML, RESX, Markdown, SQL — fully client-side.",
  "author": "poli0981 <https://github.com/poli0981>",
  "license": "Apache-2.0",
  "homepage": "https://poli0981.github.io/jsonPrism/",
  "repository": {
    "type": "git",
    "url": "https://github.com/poli0981/jsonPrism.git"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon src-tauri/icons/icon.svg",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "npm run tauri:icon && tauri android dev",
    "tauri:android:build": "npm run tauri:icon && tauri android build --apk"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.5",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@lezer/highlight": "^1.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@uiw/react-codemirror": "^4.25.10",
    "bson": "^7.3.1",
    "cbor-x": "^1.6.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "i18next": "^23.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "js-yaml": "^4.2.0",
    "lucide-react": "^0.460.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.18.1",
    "smol-toml": "^1.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^25.9.3",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.0.0",
    "knip": "^6.24.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.6"
  }
}
